a_kannada ;\012	sub pha_nukta_kannada.below by uuMatra_kannada ;\012} nukta2uu ;\012\012\012lookup matra2ja {\012	sub aaMatra_kannada by ja_nukta_kannada.below ;\012	sub auMatra_kannada by ja_nukta_kannada.below ;\012	sub uMatra_kannada by ja_nukta_kannada.below ;\012	sub uuMatra_kannada by ja_nukta_kannada.below ;\012} matra2ja ;\012\012lookup matra2pha {\012	sub aaMatra_kannada by pha_nukta_kannada.below ;\012	sub auMatra_kannada by pha_nukta_kannada.below ;\012	sub uMatra_kannada by pha_nukta_kannada.below ;\012	sub uuMatra_kannada by pha_nukta_kannada.below ;\012} matra2pha ;\012\012lookup mark_anusvara {\012	sub candrabindu_kannada by anusvara_kannada ;\012	sub udatta_deva by anusvara_kannada ;\012	sub anudatta_deva by anusvara_kannada ;\012	sub uni1CD0 by anusvara_kannada ;\012	sub uni1CD2 by anusvara_kannada ;\012	sub doubleSvarita_vedic by anusvara_kannada ;\012	sub uni1CF4 by anusvara_kannada ;\012	sub candrabindu_udatta_knda by anusvara_kannada ;\012	sub candrabindu_anudatta_knda by anusvara_kannada ;\012	sub candrabindu_1CDA_knda by anusvara_kannada ;\012} mark_anusvara ;\012\012lookup mark_reph {\012	sub candrabindu_kannada by reph_kannada ;\012	sub udatta_deva by reph_kannada ;\012	sub anudatta_deva by reph_kannada ;\012	sub uni1CD0 by reph_kannada ;\012	sub uni1CD2 by reph_kannada ;\012	sub doubleSvarita_vedic by reph_kannada ;\012	sub uni1CF4 by reph_kannada ;\012	sub candrabindu_udatta_knda by reph_kannada ;\012	sub candrabindu_anudatta_knda by reph_kannada ;\012	sub candrabindu_1CDA_knda by reph_kannada ;\012} mark_reph ;\012\012lookup mark_length {\012	sub candrabindu_kannada by length_kannada ;\012	sub udatta_deva by length_kannada ;\012	sub anudatta_deva by length_kannada ;\012	sub uni1CD0 by length_kannada ;\012	sub uni1CD2 by length_kannada ;\012	sub doubleSvarita_vedic by length_kannada ;\012	sub uni1CF4 by length_kannada ;\012	sub candrabindu_udatta_knda by length_kannada ;\012	sub candrabindu_anudatta_knda by length_kannada ;\012	sub candrab